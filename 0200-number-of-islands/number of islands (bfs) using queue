class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        numberOfIslands = 0

        rows = len(grid)
        cols = len(grid[0])

        for x in range(rows):
            for y in range(cols):

                if grid[x][y] == '1':
                    numberOfIslands += 1

                    q = deque()
                    q.append((x, y))
                    grid[x][y] = '0'

                    while q:
                        row, col = q.popleft()

                        if row - 1 >= 0 and grid[row - 1][col] == '1':
                            grid[row - 1][col] = '0'
                            q.append((row - 1, col))

                        if row + 1 < rows and grid[row + 1][col] == '1':
                            grid[row + 1][col] = '0'
                            q.append((row + 1, col))

                        if col - 1 >= 0 and grid[row][col - 1] == '1':
                            grid[row][col - 1] = '0'
                            q.append((row, col - 1))

                        if col + 1 < cols and grid[row][col + 1] == '1':
                            grid[row][col + 1] = '0'
                            q.append((row, col + 1))

        return numberOfIslands
